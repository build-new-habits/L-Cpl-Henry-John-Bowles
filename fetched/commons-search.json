{"batchcomplete":"","query":{"pages":{"86446357":{"pageid":86446357,"ns":6,"title":"File:\"sharra-bang\".jpg","index":7,"imagerepository":"local","imageinfo":[{"size":6125997,"width":5472,"height":3648,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/%22sharra-bang%22.jpg/1920px-%22sharra-bang%22.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1067,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/%22sharra-bang%22.jpg/3840px-%22sharra-bang%22.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/%22sharra-bang%22.jpg/1920px-%22sharra-bang%22.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1067,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/%22sharra-bang%22.jpg/3840px-%22sharra-bang%22.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/6/61/%22sharra-bang%22.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:%22sharra-bang%22.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=86446357","extmetadata":{"DateTime":{"value":"2020-01-30 22:30:53","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"\"sharra-bang\"","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images reviewed by FlickreviewR 2|Files with coordinates missing SDC location of creation (53\u00b0 N, 4\u00b0 W)|Buses in Llandudno|Great Orme Tour buses","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"53.327380","source":"commons-desc-page"},"GPSLongitude":{"value":"-3.831074","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"When I was younger these where called Sharra-bangs today they are called coaches. The one you can see here is parked-up waiting for customers who want to go up The Great Orme in Llandudno.\n<p>A charabanc or \"char-\u00e0-banc\" (often pronounced \"sharra-bang\" in colloquial British English) is a type of horse-drawn vehicle or early motor coach, usually open-topped, common in Britain during the early part of the 20th century. It has \"benched seats arranged in rows, looking forward, commonly used for large parties, whether as public conveyances or for excursions.\" It was especially popular for sight-seeing or \"works outings\" to the country or the seaside, organised by businesses once a year. The name derives from the French char \u00e0 bancs (\"carriage with wooden benches\"), the vehicle having originated in France in the early 19th century.\n</p>\nref:  9657 - 9th Jan 2020","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-01-09 15:43:11","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.flickr.com/photos/silvernovice/49419972003/\">https://www.flickr.com/photos/silvernovice/49419972003/</a>","source":"commons-desc-page"},"Artist":{"value":"silver-novice ~ ne res adversae impediant","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},"26833567":{"pageid":26833567,"ns":6,"title":"File:Biddles staff outing.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":51516,"width":600,"height":363,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Biddles_staff_outing.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":968,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Biddles_staff_outing.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":968},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Biddles_staff_outing.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Biddles_staff_outing.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=26833567","extmetadata":{"DateTime":{"value":"2013-06-23 16:52:14","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Biddles staff outing","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Attribution only license|Unidentified buses in the United Kingdom|Black and white photographs of buses|Charabanc style motor coaches in the United Kingdom|Biddles the Book Printer","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Biddles the Book Printers staff outing","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2013-06-23","source":"commons-desc-page"},"Credit":{"value":"The Biddle family","source":"commons-desc-page"},"Artist":{"value":"Ex-Biddles staff 2013","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}}}]},"14573095":{"pageid":14573095,"ns":6,"title":"File:Fred C Palmer East Cliff 001.jpg","index":8,"imagerepository":"local","imageinfo":[{"size":908572,"width":3340,"height":2080,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Fred_C_Palmer_East_Cliff_001.jpg/1920px-Fred_C_Palmer_East_Cliff_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":996,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/0/00/Fred_C_Palmer_East_Cliff_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Fred_C_Palmer_East_Cliff_001.jpg/1920px-Fred_C_Palmer_East_Cliff_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":996,"srcset":"https://upload.wikimedia.org/wikipedia/commons/0/00/Fred_C_Palmer_East_Cliff_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/00/Fred_C_Palmer_East_Cliff_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Fred_C_Palmer_East_Cliff_001.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=14573095","extmetadata":{"DateTime":{"value":"2011-03-12 09:30:19","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Fred C Palmer East Cliff 001","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD-old-70-expired|PD-Art (PD-old-70-expired)|CC-PD-Mark|Postcards of Herne Bay|PD-Art missing SDC copyright status|PD-old missing SDC copyright status|Herne Bay Kings Hall 1904-1950|Fred C Palmer of Herne Bay","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>Postcard photo of East Cliff at Herne Bay, Kent, England.  The postcard is unused, but it is dated on the grounds that the Grand Pier Pavilion in the background was built in 1910, and the Kings Hall has not yet had its 1913 rebuild. The photographer was Fred C. Palmer of Tower Studio, Herne Bay, <a href=\"//commons.wikimedia.org/wiki/Kent\" title=\"Kent\">Kent</a>, who is believed to have died 1936-1939. \n</p><p>Points of interest: \n</p>\n<ul><li>Among the posed group of people in the centre foreground, the lad on the grass is smiling cheekily, as if perhaps he has done this before.  Could he be Palmer's son Leslie Reginald, born 1896?</li>\n<li>The large group in the top left distance might be a Sunday works or church outing; these outings would arrive by train or charabanc.</li>\n<li>The sea is full of boats; some perhaps bringing fish or seafood for the caterers. There are very few inshore boats at Herne Bay today.</li>\n<li><a href=\"https://en.wikipedia.org/wiki/King%27s_Hall,_Herne_Bay\" class=\"extiw\" title=\"w:King's Hall, Herne Bay\">The Pavilion</a> with bandstand on top can be seen in the distance.</li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Notes_for_editors\">Notes for editors</h2></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Contrast\">Contrast</h3></div>\n<p>Please note that this century-old photo has darkened with age.  It is likely to be counter-productive to adjust the contrast because detail would be lost in the light or pale areas.  If you wish to upload a contrast-adjusted version, please consider uploading it as a separate image, with a link to this image.  Thank you for your consideration.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Border\">Border</h3></div>\nThe border of this image is important for researchers of this photographer. Some photographers trimmed their images more than others, and Palmer has a reputation for producing smaller postcards than other early 20th century UK photographers. He took his own photos, developed them in-house onto postcard-backed photographic paper and trimmed them himself. It is worth adding that during hand-developing the border is actively masked with equipment which both crops the picture and causes the white frame or border to appear on the paper. This frame is part of the design and is one of the reasons why the quality of Palmer's work is so interesting, and why there is an article and category for him on English Wiki. Researchers need to see exactly where the edge of the postcard is. If you wish to upload a cropped image, please consider uploading it as a separate image, with a link to this one. Thank you for taking the time to read this.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"between 1910 and 1913<div style=\"display: none;\">date QS:P,+1910-00-00T00:00:00Z/8,P1319,+1910-00-00T00:00:00Z/9,P1326,+1913-00-00T00:00:00Z/9</div>","source":"commons-desc-page"},"Credit":{"value":"Scan of original postcard in my possession","source":"commons-desc-page"},"Artist":{"value":"Fred C. Palmer (died 1936-1939)","source":"commons-desc-page"},"Permission":{"value":"out of copyright","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"13537669":{"pageid":13537669,"ns":6,"title":"File:Great Dorset Steam Fair - geograph.org.uk - 850380.jpg","index":5,"imagerepository":"local","imageinfo":[{"size":125510,"width":640,"height":515,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/6/63/Great_Dorset_Steam_Fair_-_geograph.org.uk_-_850380.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1288,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/6/63/Great_Dorset_Steam_Fair_-_geograph.org.uk_-_850380.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1288},"url":"https://upload.wikimedia.org/wikipedia/commons/6/63/Great_Dorset_Steam_Fair_-_geograph.org.uk_-_850380.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Great_Dorset_Steam_Fair_-_geograph.org.uk_-_850380.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=13537669","extmetadata":{"DateTime":{"value":"2011-02-21 02:23:47","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Great Dorset Steam Fair - geograph.org.uk - 850380","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Images from Geograph Britain and Ireland|Information field template with formatting|Dennis G and GL|Photographs by Dr Neil Clifton|Images from Geograph Britain and Ireland missing SDC coordinates of the point of view|Great Dorset Steam Fair (2003)|Preserved charabanc motor buses in the United Kingdom","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"50.894000","source":"commons-desc-page"},"GPSLongitude":{"value":"-2.110000","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"1928 Dennis G with a replica Roberts charabanc body fitted about 1960<br>Great Dorset Steam Fair A Dennis charabanc.  These vehicles were very popular for outings in the 1920s before the development of the modern motorcoach.  Sometimes they were pressed into service on bus routes, or alternatively proprietors would use them to 'pirate' established routes - until the practice was made illegal.  The type has now almost disappeared. This example was unusual in that it had inflatable tyres.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2003-08-30","source":"commons-desc-page"},"Credit":{"value":"From <a rel=\"nofollow\" class=\"external text\" href=\"https://www.geograph.org.uk/photo/850380\">geograph.org.uk</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.geograph.org.uk/profile/796\">Dr Neil Clifton</a>","source":"commons-desc-page"},"Attribution":{"value":"Dr Neil Clifton","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-2.0","source":"commons-templates","hidden":""}}}]},"13548125":{"pageid":13548125,"ns":6,"title":"File:Great Dorset Steam Fair - geograph.org.uk - 868388.jpg","index":6,"imagerepository":"local","imageinfo":[{"size":86526,"width":640,"height":444,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Great_Dorset_Steam_Fair_-_geograph.org.uk_-_868388.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1110,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Great_Dorset_Steam_Fair_-_geograph.org.uk_-_868388.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1110},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b8/Great_Dorset_Steam_Fair_-_geograph.org.uk_-_868388.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Great_Dorset_Steam_Fair_-_geograph.org.uk_-_868388.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=13548125","extmetadata":{"DateTime":{"value":"2011-02-21 05:42:44","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Great Dorset Steam Fair - geograph.org.uk - 868388","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Images from Geograph Britain and Ireland|Information field template with formatting|Dennis G and GL|Photographs by Dr Neil Clifton|United Kingdom photographs taken on 2005-09-02|Images from Geograph Britain and Ireland missing SDC coordinates of the point of view|Great Dorset Steam Fair (2005)|Preserved charabanc motor buses in the United Kingdom","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"50.894000","source":"commons-desc-page"},"GPSLongitude":{"value":"-2.110000","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"Great Dorset Steam Fair Charabancs, when fitted with pneumatic tyres, seem like ideal vehicles for a summer outing, but the type has almost disappeared from British roads.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2005-09-02","source":"commons-desc-page"},"Credit":{"value":"From <a rel=\"nofollow\" class=\"external text\" href=\"https://www.geograph.org.uk/photo/868388\">geograph.org.uk</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.geograph.org.uk/profile/796\">Dr Neil Clifton</a>","source":"commons-desc-page"},"Attribution":{"value":"Dr Neil Clifton","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-2.0","source":"commons-templates","hidden":""}}}]},"14873981":{"pageid":14873981,"ns":6,"title":"File:Herne Kent 1905 001.jpg","index":4,"imagerepository":"local","imageinfo":[{"size":2017528,"width":3280,"height":2072,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Herne_Kent_1905_001.jpg/1920px-Herne_Kent_1905_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1011,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Herne_Kent_1905_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Herne_Kent_1905_001.jpg/1920px-Herne_Kent_1905_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1011,"srcset":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Herne_Kent_1905_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/ad/Herne_Kent_1905_001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Herne_Kent_1905_001.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=14873981","extmetadata":{"DateTime":{"value":"2011-04-11 11:34:37","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Herne Kent 1905 001","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD-UK|Herne, Kent|Roads in Kent|Template Unknown (author)|Horse-drawn charabancs in the United Kingdom|Postcards of Herne, Kent","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>Postcard photo of the Canterbury-Herne Bay road as it passes through Herne, Kent, England. The postcard is postmarked 1905.  On the right is Smugglers Cottage.  The two pubs on the left are called Upper Red Lion and Lower Red Lion.\n</p>\n<dl><dt>Points of interest</dt>\n<dd></dd></dl>\n<ul><li>The group on the charabanc is possibly returning from a Sunday church or works outing to Herne Bay.</li>\n<li>The liveried coach could be a mail coach.</li>\n<li>The card is published by J.J. Moffat, stationer of Herne.</li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Editing\">Editing</h2></div>\n<p>This is an unedited scan of an historical photograph. If making adjustments to this image, please consider uploading your edit as a separate file.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Contrast\">Contrast</h3></div>\n<p>This print has darkened with age, but it would be inappropriate to adjust the brightness because detail would be lost.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Edges\">Edges</h3></div>\nThe remaining borderless edges of this image are important for researchers of this type of vintage photograph. Some photographers trimmed their images more than others,and the border or edge is part of the artwork. Researchers need to see exactly where the edge of the postcard is. Thank you for taking the time to read this.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Postmarked 1905","source":"commons-desc-page"},"Credit":{"value":"Scan of original postcard in my possession","source":"commons-desc-page"},"Artist":{"value":"Unknown author<span style=\"display: none;\">Unknown author</span>","source":"commons-desc-page"},"Permission":{"value":"out of copyright","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"15717400":{"pageid":15717400,"ns":6,"title":"File:Students from the Sunderland Council Blind School, going on a class visit to a hayfield (1924).jpg","index":2,"imagerepository":"local","imageinfo":[{"size":44856,"width":632,"height":496,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/0/0c/Students_from_the_Sunderland_Council_Blind_School%2C_going_on_a_class_visit_to_a_hayfield_%281924%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1256,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/0/0c/Students_from_the_Sunderland_Council_Blind_School%2C_going_on_a_class_visit_to_a_hayfield_%281924%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1256},"url":"https://upload.wikimedia.org/wikipedia/commons/0/0c/Students_from_the_Sunderland_Council_Blind_School%2C_going_on_a_class_visit_to_a_hayfield_%281924%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Students_from_the_Sunderland_Council_Blind_School,_going_on_a_class_visit_to_a_hayfield_(1924).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=15717400","extmetadata":{"DateTime":{"value":"2011-07-06 10:32:53","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Students from the Sunderland Council Blind School, going on a class visit to a hayfield (1924)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Libraries in Tyne and Wear|Photos uploaded from Flickr by F\u00e6 using a script|Flickr images reviewed by File Upload Bot (Magnus Manske)|Files from Flickr's 'The Commons'|Files with coordinates missing SDC location of creation (54\u00b0 N, 2\u00b0 W)|Buses in Sunderland|Seeing Through Touch collection (Tyne and Wear Archives and Museums)|Sunderland Museum Archive Photographs|Charabanc style motor coaches in the United Kingdom","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"54.904806","source":"commons-desc-page"},"GPSLongitude":{"value":"-1.381101","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>July 1924. Children from Sunderland School for the blind going on an excursion to the hayfields. The charabanc is parked outside the Central Library and Museum in Sunderland. Many of the children had never been in a motor before.\n</p><p>\u201cTo them, their fingers are eyes\u201d\n</p><p>From 1913, John Alfred Charlton Deas, a former curator at Sunderland Museum, organised several handling sessions for the blind, first offering an invitation to the children from the Sunderland Council Blind School, to handle a few of the collection